pageType: cover
background:
  type: solid
  color: "$primary"
elements:
  - elementId: title
    elementType: text
    bounds: [100, 200, 760, 80]
    content:
      style: "$title"
      align: [center, middle]
      text: 你好 SlideForge
  - elementId: subtitle
    elementType: text
    bounds: [100, 290, 760, 40]
    content:
      align: [center, middle]
      color: "#ffffff"
      text: 用 PPTD 写幻灯片
  - elementId: badge
    elementType: shape
    bounds: [420, 120, 120, 60]
    shapeName: roundRect
    adjustments: [16667]
    fill: {type: solid, color: "$accent"}
  - elementId: line1
    elementType: line
    bounds: [200, 360, 560, 0]
    viewBox: [560, 1]
    points: "0,0 560,0"
    curve: sharp
    border: {style: solid, width: 2, color: "#ffffff"}
